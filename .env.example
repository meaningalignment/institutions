POSTGRES_URL=postgresql://...

# Passwordless admin sign-in
SESSION_SECRET=replace-with-at-least-32-random-characters
MAILGUN_API_KEY=key-...
MAILGUN_DOMAIN=mg.example.org
MAILGUN_FROM=AGI Institutions <login@mg.example.org>
# Set to "eu" only when the Mailgun domain is in the EU region.
MAILGUN_REGION=us

# X list sync (admin X list tab and People checkbox). Set these on Vercel too.
# OAuth 1.0a keys from the X Developer Console, with the access token and
# secret generated for the account that owns the list. Every admin's changes
# to the list are made as that account.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_LIST_ID=1561387239183159300
